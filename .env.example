# --- Base de datos (SQL Server) ---
# En docker-compose el host es el nombre del servicio: sqlserver
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
# Requerida por SQL Server: 8+ caracteres con mayúsculas, minúsculas, número y símbolo.
DB_PASSWORD=EsteEsUnPassword123!
DB_NAME=btg_posts

# --- API (NestJS) ---
API_PORT=3000
# Origen permitido por CORS. En local: el dev server de Vite; en compose: el puerto del web.
WEB_ORIGIN=http://localhost:4200
# Carga los datos iniciales al arrancar, solo si la tabla posts está vacía.
SEED_ON_BOOT=true

# --- Web (Vite) ---
# En local apunta directo a la API; en compose nginx proxea /api en el mismo origen.
VITE_API_URL=http://localhost:3000/api
WEB_PORT=8080
